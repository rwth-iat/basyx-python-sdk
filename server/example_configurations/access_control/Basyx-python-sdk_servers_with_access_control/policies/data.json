{
  "access_control": {
    "public_path_prefixes": [
      "/",
      "/ui"
    ],
    "rules": [
      {
        "description": "Editors and admins can read repository resources.",
        "path_prefix": "/repository",
        "methods": [
          "GET",
          "HEAD"
        ],
        "roles": [
          "editor",
          "admin"
        ]
      },
      {
        "description": "Editors and admins can change repository resources.",
        "path_prefix": "/repository",
        "methods": [
          "POST",
          "PUT",
          "PATCH"
        ],
        "roles": [
          "editor",
          "admin"
        ]
      },
      {
        "description": "Only admins can delete repository resources.",
        "path_prefix": "/repository",
        "methods": [
          "DELETE"
        ],
        "roles": [
          "admin"
        ]
      },
      {
        "description": "Editors and admins can read registry resources.",
        "path_prefix": "/registry",
        "methods": [
          "GET",
          "HEAD"
        ],
        "roles": [
          "editor",
          "admin"
        ]
      },
      {
        "description": "Editors and admins can change registry resources.",
        "path_prefix": "/registry",
        "methods": [
          "POST",
          "PUT"
        ],
        "roles": [
          "editor",
          "admin"
        ]
      },
      {
        "description": "Only admins can delete registry resources.",
        "path_prefix": "/registry",
        "methods": [
          "DELETE"
        ],
        "roles": [
          "admin"
        ]
      },
      {
        "description": "Editors and admins can read discovery resources.",
        "path_prefix": "/discovery",
        "methods": [
          "GET",
          "HEAD"
        ],
        "roles": [
          "editor",
          "admin"
        ]
      },
      {
        "description": "Editors and admins can run discovery lookups that return collections.",
        "path_prefix": "/discovery/api/v3.1/lookup/shellsByAssetLink",
        "methods": [
          "POST"
        ],
        "roles": [
          "editor",
          "admin"
        ]
      },
      {
        "description": "Editors and admins can change discovery resources.",
        "path_prefix": "/discovery",
        "methods": [
          "POST",
          "PUT"
        ],
        "roles": [
          "editor",
          "admin"
        ]
      },
      {
        "description": "Only admins can delete discovery resources.",
        "path_prefix": "/discovery",
        "methods": [
          "DELETE"
        ],
        "roles": [
          "admin"
        ]
      }
    ],
    "resource_rules": [
      {
        "description": "Viewers can read only selected AAS endpoints. IDs are the base64url path identifiers used by the HTTP API: https://example.org/Test_AssetAdministrationShell (from example_data/example_aas.json).",
        "path_templates": [
          "/repository/api/v3.1/shells/{aas_id}",
          "/registry/api/v3.1/shell-descriptors/{aas_id}",
          "/discovery/api/v3.1/lookup/shells/{aas_id}"
        ],
        "ids": [
          "aHR0cHM6Ly9leGFtcGxlLm9yZy9UZXN0X0Fzc2V0QWRtaW5pc3RyYXRpb25TaGVsbA"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "roles": [
          "viewer"
        ]
      },
      {
        "description": "Viewers can read only selected Submodel endpoints. IDs are the base64url path identifiers used by the HTTP API: http://example.org/Submodels/Assets/TestAsset/Identification and https://example.org/Test_Submodel. The BillOfMaterial submodel of the same shell is deliberately not listed.",
        "path_templates": [
          "/repository/api/v3.1/submodels/{submodel_id}",
          "/repository/api/v3.1/shells/{aas_id}/submodels/{submodel_id}",
          "/registry/api/v3.1/submodel-descriptors/{submodel_id}",
          "/registry/api/v3.1/shell-descriptors/{aas_id}/submodel-descriptors/{submodel_id}"
        ],
        "ids": [
          "aHR0cDovL2V4YW1wbGUub3JnL1N1Ym1vZGVscy9Bc3NldHMvVGVzdEFzc2V0L0lkZW50aWZpY2F0aW9u",
          "aHR0cHM6Ly9leGFtcGxlLm9yZy9UZXN0X1N1Ym1vZGVs"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "roles": [
          "viewer"
        ]
      }
    ]
  }
}