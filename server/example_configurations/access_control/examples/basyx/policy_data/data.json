{
  "access_control": {
    "api_version": "v3.1",
    "role_claim": "realm_access.roles",
    "api_base_paths": [
      "/repository/api/{api_version}",
      "/registry/api/{api_version}",
      "/discovery/api/{api_version}"
    ],
    "additional_operations": [
      {"name": "GetAllQualifiers", "method": "GET", "path": "/submodels/{submodelIdentifier}/qualifiers", "rights": ["READ"]},
      {"name": "PostQualifier", "method": "POST", "path": "/submodels/{submodelIdentifier}/qualifiers", "rights": ["CREATE"]},
      {"name": "GetQualifierByType", "method": "GET", "path": "/submodels/{submodelIdentifier}/qualifiers/{qualifierType}", "rights": ["READ"]},
      {"name": "PutQualifierByType", "method": "PUT", "path": "/submodels/{submodelIdentifier}/qualifiers/{qualifierType}", "rights": ["UPDATE"]},
      {"name": "DeleteQualifierByType", "method": "DELETE", "path": "/submodels/{submodelIdentifier}/qualifiers/{qualifierType}", "rights": ["DELETE"]},
      {"name": "GetAllQualifiersByPath", "method": "GET", "path": "/submodels/{submodelIdentifier}/submodel-elements/{idShortPath}/qualifiers", "rights": ["READ"]},
      {"name": "PostQualifierByPath", "method": "POST", "path": "/submodels/{submodelIdentifier}/submodel-elements/{idShortPath}/qualifiers", "rights": ["CREATE"]},
      {"name": "GetQualifierByPathAndType", "method": "GET", "path": "/submodels/{submodelIdentifier}/submodel-elements/{idShortPath}/qualifiers/{qualifierType}", "rights": ["READ"]},
      {"name": "PutQualifierByPathAndType", "method": "PUT", "path": "/submodels/{submodelIdentifier}/submodel-elements/{idShortPath}/qualifiers/{qualifierType}", "rights": ["UPDATE"]},
      {"name": "DeleteQualifierByPathAndType", "method": "DELETE", "path": "/submodels/{submodelIdentifier}/submodel-elements/{idShortPath}/qualifiers/{qualifierType}", "rights": ["DELETE"]}
    ],
    "public_paths": [
      "/"
    ],
    "public_path_prefixes": [
      "/ui"
    ],
    "rules": [
      {
        "description": "Editors and admins can read repository resources.",
        "path_prefix": "/repository",
        "rights": ["READ", "VIEW"],
        "roles": ["editor", "admin"]
      },
      {
        "description": "Editors and admins can create and change repository resources and invoke operations.",
        "path_prefix": "/repository",
        "rights": ["CREATE", "UPDATE", "EXECUTE"],
        "roles": ["editor", "admin"]
      },
      {
        "description": "Only admins can delete repository resources.",
        "path_prefix": "/repository",
        "rights": ["DELETE"],
        "roles": ["admin"]
      },
      {
        "description": "Editors and admins can read registry resources.",
        "path_prefix": "/registry",
        "rights": ["READ", "VIEW"],
        "roles": ["editor", "admin"]
      },
      {
        "description": "Editors and admins can create and change registry resources.",
        "path_prefix": "/registry",
        "rights": ["CREATE", "UPDATE"],
        "roles": ["editor", "admin"]
      },
      {
        "description": "Only admins can delete registry resources.",
        "path_prefix": "/registry",
        "rights": ["DELETE"],
        "roles": ["admin"]
      },
      {
        "description": "Editors and admins can read discovery resources and run lookups such as POST lookup/shellsByAssetLink.",
        "path_prefix": "/discovery",
        "rights": ["READ", "VIEW"],
        "roles": ["editor", "admin"]
      },
      {
        "description": "Editors and admins can create and change discovery resources.",
        "path_prefix": "/discovery",
        "rights": ["CREATE", "UPDATE"],
        "roles": ["editor", "admin"]
      },
      {
        "description": "Only admins can delete discovery resources.",
        "path_prefix": "/discovery",
        "rights": ["DELETE"],
        "roles": ["admin"]
      }
    ],
    "routes": [
      "/repository/api/{api_version}/shells/{aas}",
      "/repository/api/{api_version}/shells/{aas}/submodels/{submodel}",
      "/repository/api/{api_version}/submodels/{submodel}",
      "/registry/api/{api_version}/shell-descriptors/{aas}",
      "/registry/api/{api_version}/shell-descriptors/{aas}/submodel-descriptors/{submodel}",
      "/registry/api/{api_version}/submodel-descriptors/{submodel}",
      "/discovery/api/{api_version}/lookup/shells/{aas}"
    ],
    "collections": [
      {"path": "/repository/api/{api_version}/shells", "resource": "aas"},
      {"path": "/repository/api/{api_version}/shells/{aas}/submodel-refs", "resource": "submodel"},
      {"path": "/repository/api/{api_version}/submodels", "resource": "submodel"},
      {"path": "/registry/api/{api_version}/shell-descriptors", "resource": "aas"},
      {"path": "/registry/api/{api_version}/shell-descriptors/{aas}/submodel-descriptors", "resource": "submodel"},
      {"path": "/registry/api/{api_version}/submodel-descriptors", "resource": "submodel"},
      {"path": "/discovery/api/{api_version}/lookup/shells", "resource": "aas"}
    ],
    "resource_rules": [
      {
        "description": "Viewers can read the example shell (example_data/example_aas.json) in the repository, registry and discovery.",
        "resource": "aas",
        "ids": ["https://example.org/Test_AssetAdministrationShell"],
        "rights": ["READ", "VIEW"],
        "roles": ["viewer"]
      },
      {
        "description": "Viewers can read two of the example shell's three submodels; BillOfMaterial is deliberately not listed.",
        "resource": "submodel",
        "ids": [
          "http://example.org/Submodels/Assets/TestAsset/Identification",
          "https://example.org/Test_Submodel"
        ],
        "rights": ["READ", "VIEW"],
        "roles": ["viewer"]
      }
    ]
  }
}
