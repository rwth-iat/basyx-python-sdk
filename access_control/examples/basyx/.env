# Configuration of the secured BaSyx stack. Docker Compose reads this file automatically.
# The values are defaults for a local demo; change them here and nowhere else.

# --- AAS API ---------------------------------------------------------------------------------------------------------
# Version segment of the server base paths, e.g. /repository/api/v3.1
API_VERSION=v3.1

# --- Public endpoints, as seen by the browser ------------------------------------------------------------------------
GATEWAY_PORT=10000
PUBLIC_URL=http://localhost:10000
KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://localhost:8080
# Envoy admin interface, bound to 127.0.0.1 only
ENVOY_ADMIN_PORT=8001

# --- Identity provider (OpenID Connect) ------------------------------------------------------------------------------
OIDC_REALM=basyx-secured-stack
# Issuer as written into the tokens (Keycloak uses its public URL)
OIDC_ISSUER=${KEYCLOAK_URL}/realms/${OIDC_REALM}
# Client of the Web UI; Envoy only accepts tokens issued for this audience
OIDC_CLIENT_ID=basyx-web-ui
# Where Envoy fetches the signing keys, from inside the Docker network
OIDC_JWKS_HOST=keycloak
OIDC_JWKS_PORT=8080
OIDC_JWKS_PATH=/realms/${OIDC_REALM}/protocol/openid-connect/certs
# Token claim with the user's roles, as a dot-separated path
ROLE_CLAIM=realm_access.roles

# --- AAS servers behind the gateway ----------------------------------------------------------------------------------
# Point these to other servers (e.g. BaSyx Java) to protect them instead of the bundled BaSyx Python servers.
REPOSITORY_HOST=repository
REPOSITORY_PORT=80
REGISTRY_HOST=registry
REGISTRY_PORT=80
DISCOVERY_HOST=discovery
DISCOVERY_PORT=80

# --- Demo credentials: change them for anything beyond a local demo ---------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Images ----------------------------------------------------------------------------------------------------------
ENVOY_IMAGE=envoyproxy/envoy:v1.31.10
# "-envoy-static" is published for amd64 and arm64
OPA_IMAGE=openpolicyagent/opa:1.21.2-envoy-static
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:25.0.4
AAS_WEB_UI_IMAGE=eclipsebasyx/aas-gui:v2-261013
BASYX_REPOSITORY_IMAGE=eclipsebasyx/basyx-python-repository:2.2.0
BASYX_REGISTRY_IMAGE=eclipsebasyx/basyx-python-registry:2.2.0
BASYX_DISCOVERY_IMAGE=eclipsebasyx/basyx-python-discovery:2.2.0
# Only used for its envsubst tool, to render the configuration templates
RENDERER_IMAGE=nginx:1.27-alpine
